# Copy this file to server/.env and edit the values. Only FOUR lines need a
# real value on a fresh machine: GOOGLE_AI_API_KEY, GROQ_API_KEY, CURRENTS_API_KEY
# and DB_PASSWORD. Everything else already holds a working setting. Run
# `npm run check` from server/ to confirm before starting the app.
#
# Values are written bare, with no quotes: DB_PASSWORD=secret, not "secret".

PORT=3000

# Google AI Studio key. Create one at https://aistudio.google.com/apikey — it
# is free, needs a Google account, and takes under a minute. This one key
# serves the resume review, the chatbot, the mock interview and the gap
# analysis. Never commit the real value.
GOOGLE_AI_API_KEY=your_google_ai_studio_key_here

# Groq key for live interview dictation. Create one at
# https://console.groq.com/keys — it is free and needs only an account. The
# browser records the candidate's answer and Whisper, on Groq, transcribes it.
# Optional: without it the server still starts and every interview still runs,
# but the live mode's record button is replaced by a note to type instead.
# Never commit the real value.
GROQ_API_KEY=your_groq_api_key_here

# The Whisper model on Groq. Optional; leave it commented out to use the
# default, whisper-large-v3-turbo (fast, and accurate for English). The other
# choice is whisper-large-v3: slower, slightly more accurate. Groq retires
# models from time to time, and a TRANSCRIBE_MODEL line in the log means this
# needs a new value.
# WHISPER_MODEL=whisper-large-v3-turbo

# Currents News API key for the dynamic homepage news feed. Create a free key
# at https://currentsapi.services/. It is used only by the server and must
# never be placed in the client or committed.
CURRENTS_API_KEY=your_currents_api_key_here

# AI model routing, resolved per tier in ai-service/src/utils/aiClient.js.
#
# Both are REQUIRED. The server exits at startup if either is missing, and
# there is no hardcoded fallback anywhere in the code: an unset value is a
# boot failure, never a silent substitution.
#
# Production model: a SINGLE model on both tiers until further notice.
#   AI_MODEL_FREE    -> gemini-3.6-flash   (Gemini 3.6 Flash)
#   AI_MODEL_PREMIUM -> gemini-3.6-flash   (Gemini 3.6 Flash)
#
# These are Google AI Studio model ids, which have NO vendor prefix. The
# OpenRouter form 'google/gemini-3.6-flash' is a 404 against this endpoint —
# check that first if model resolution starts failing.
#
# Do NOT trust the /v1beta/openai/models listing when choosing a value. It
# advertises models that 404 on use: gemini-2.5-flash and gemini-2.5-pro are
# both listed but are closed to new API keys, and the only way to find out is
# to send a real completion. Verify any replacement with an actual request.
#
# This supersedes the GLM-5.2 pair (client decision 2026-08-22) and the split
# in the May 2026 feasibility report (Gemini 3.1 Flash Lite free / Claude
# Haiku 4.5 premium, never live). Neither survives the move to Google AI
# Studio: GLM and Claude are not served there. Both variables stay separate so
# a split within Google's catalogue is a pure env-var change, no code edit.
#
# The GPT-4o family is banned as a production model by client decision and is
# rejected both at startup and on every model resolution.
AI_MODEL_FREE=gemini-3.6-flash
AI_MODEL_PREMIUM=gemini-3.6-flash

# Signs login sessions. Any random string of 32 or more characters; the server
# refuses the placeholder below. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_32plus_char_secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Email: verification at signup, the emailed login code, password reset.
#
# Optional. With SMTP_HOST unset nothing can reach an inbox, so email
# verification and the login code are switched off and sign-in is by password
# alone (the server says so at startup). Fill these in to turn them on; for
# Gmail use smtp.gmail.com, port 465 and an app password.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Digital Career Hub <no-reply@example.com>"
#
# Development only: print every email, codes and links included, to the server
# log instead of sending it. This turns verification and the login code on, so
# the whole flow can be tried without a mail account. Ignored in production.
# EMAIL_TRANSPORT=console
#
# Where links in those emails point. Defaults to http://localhost:5173, or the
# production domain on Vercel.
# CLIENT_ORIGIN=http://localhost:5173

# Google sign-in (optional). Both must be set for /api/oauth/google to work;
# SERVER_URL is the public address Google redirects back to.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SERVER_URL=http://localhost:3000
# Database connection.
#
# Two styles, pick one. For a local Postgres, fill in the DB_* variables below
# and leave DATABASE_URL unset. For the shared hosted database, set DATABASE_URL
# to the connection string the provider gives you and the DB_* values are
# ignored.
#
# DATABASE_URL=postgresql://user:password@host:port/database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=career_hub_db
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# TLS. Leave blank for a local Postgres, which does not use it.
#
# A hosted database almost always REQUIRES TLS and will refuse the connection
# without it. The failure does not mention TLS, so it reads as a generic
# connection error — if the app cannot reach the shared database, check this
# first.
#
#   DB_SSL=true        encrypted, certificate verified (needs DB_SSL_CA)
#   DB_SSL=no-verify   encrypted, certificate NOT verified
#
# no-verify is what most provider quick-starts tell you to use. It stops
# eavesdropping but not an active machine-in-the-middle. Fine for coursework on
# a private instance; download the provider's CA and point DB_SSL_CA at it for
# anything beyond that.
DB_SSL=
# DB_SSL_CA=/absolute/path/to/ca.pem
