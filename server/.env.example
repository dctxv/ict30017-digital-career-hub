PORT=3000
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI model routing, resolved per tier in ai-service/src/utils/aiClient.js.
#
# Both are REQUIRED. The server exits at startup if either is missing, and
# there is no hardcoded fallback anywhere in the code: an unset value is a
# boot failure, never a silent substitution.
#
# Production models (May 2026 feasibility report, confirmed with the client):
#   AI_MODEL_FREE    -> google/gemini-3.1-flash-lite   (Gemini 3.1 Flash Lite)
#   AI_MODEL_PREMIUM -> anthropic/claude-haiku-4.5     (Claude Haiku 4.5)
#
# Those two are NOT live yet, pending client API budget approval. Point both
# tiers at the current working model until then; the cutover is a pure
# env-var change with no code edit.
#
# The GPT-4o family is banned as a production model by client decision and is
# rejected both at startup and on every model resolution.
AI_MODEL_FREE=your_model_here
AI_MODEL_PREMIUM=your_model_here

JWT_SECRET=replace_with_a_random_32plus_char_secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DB_USER=postgres
DB_HOST=localhost
DB_NAME=career_hub_db
DB_PASSWORD=your_db_password_here
DB_PORT=5432
