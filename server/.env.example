PORT=3000
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI model routing, resolved per tier in ai-service/src/utils/aiClient.js.
#
# Both are REQUIRED. The server exits at startup if either is missing, and
# there is no hardcoded fallback anywhere in the code: an unset value is a
# boot failure, never a silent substitution.
#
# Production model (client decision, 2026-08-22): a SINGLE model on both tiers
# until further notice.
#   AI_MODEL_FREE    -> z-ai/glm-5.2   (GLM-5.2)
#   AI_MODEL_PREMIUM -> z-ai/glm-5.2   (GLM-5.2)
#
# This supersedes the split in the May 2026 feasibility report (Gemini 3.1
# Flash Lite free / Claude Haiku 4.5 premium), which never went live. Both
# variables stay separate so that split is a pure env-var change if the client
# asks for it back — no code edit either way.
#
# The GPT-4o family is banned as a production model by client decision and is
# rejected both at startup and on every model resolution.
AI_MODEL_FREE=your_model_here
AI_MODEL_PREMIUM=your_model_here

JWT_SECRET=replace_with_a_random_32plus_char_secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Database connection.
#
# Two styles, pick one. For a local Postgres, fill in the DB_* variables below
# and leave DATABASE_URL unset. For the shared hosted database, set DATABASE_URL
# to the connection string the provider gives you and the DB_* values are
# ignored.
#
# DATABASE_URL=postgresql://user:password@host:port/database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=career_hub_db
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# TLS. Leave blank for a local Postgres, which does not use it.
#
# A hosted database almost always REQUIRES TLS and will refuse the connection
# without it. The failure does not mention TLS, so it reads as a generic
# connection error — if the app cannot reach the shared database, check this
# first.
#
#   DB_SSL=true        encrypted, certificate verified (needs DB_SSL_CA)
#   DB_SSL=no-verify   encrypted, certificate NOT verified
#
# no-verify is what most provider quick-starts tell you to use. It stops
# eavesdropping but not an active machine-in-the-middle. Fine for coursework on
# a private instance; download the provider's CA and point DB_SSL_CA at it for
# anything beyond that.
DB_SSL=
# DB_SSL_CA=/absolute/path/to/ca.pem
