# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────
# Option A (preferred for cloud deployments):
# DATABASE_URL=postgresql://user:password@localhost:5432/digitalcareerhub

# Option B: individual fields
DB_USER=postgres
DB_HOST=localhost
DB_NAME=digitalcareerhub
DB_PASSWORD=sineth
DB_PORT=5432

# ── AI Inference ──────────────────────────────────────────────────
# ⚠ NEVER commit a real key. Set via deployment platform env vars.
DIGITALOCEAN_API_KEY=your_do_api_key_here
AI_MODEL=minimax-m2.5

# ── Auth ──────────────────────────────────────────────────────────
# REQUIRED: at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ NEVER commit a real secret.
JWT_SECRET=fea0165c11da8a091aa1a00f37d527760ea79db1041273561065ef90f9c9d6c8

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production: ALLOWED_ORIGINS=https://digitalcareerhub.app

# ── Email (Nodemailer) ────────────────────────────────────────────
# Leave blank in development — tokens are printed to the console instead.
# For production, configure ONE of the options below:
#
# Option A — Gmail (use an App Password, not your real password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
#
# Option B — SendGrid SMTP relay:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
#
# Option C — Resend SMTP:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key
#
# Option D — Mailtrap (testing inbox, safe to commit):
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_mailtrap_user
# SMTP_PASS=your_mailtrap_pass
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Digital Career Hub" <noreply@digitalcareerhub.app>

# ── App ───────────────────────────────────────────────────────────
APP_NAME=Digital Career Hub
APP_BASE_URL=http://localhost:5173
# Production: APP_BASE_URL=https://digitalcareerhub.app
